{
  "manifest_version": 2,
  "name": "WhatsApp Ping Everyone",
  "version": "1.0",
  "description": "Easily ping everyone in a WhatsApp Web group chat",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-firefox.js"],
      "run_at": "document_end"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Ping Everyone"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}